# Local development (docker compose up -d db)
DATABASE_URL="postgresql://vocab:vocab@localhost:5432/vocab"

# Supabase (see docs/deploy-vercel.md):
# DATABASE_URL = transaction pooler, used by the app:
#   postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# DIRECT_URL = session pooler, used for migrations:
#   postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_CA_CERT = Supabase CA certificate (PEM) to verify the server; recommended
# DIRECT_URL=""
# DATABASE_CA_CERT=""

# Auth.js — generate with: npx auth secret
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID app registration (leave empty locally to use dev login only)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Maps Entra group object IDs to roles. domain = a domain key, or null for all domains.
# Example: {"0b1c...":{"role":"ADMIN","domain":null},"7d2e...":{"role":"OWNER","domain":"claims"}}
ROLE_GROUP_MAP="{}"

# test | production | development. Defaults from VERCEL_ENV (preview = test). Test shows a TEST bar.
# APP_ENV=""

# Every signed-in employee is a viewer. Set to CONTRIBUTOR to let everyone propose changes.
DEFAULT_ROLE="VIEWER"

# Dev-only login as seeded demo users. Ignored in production builds.
AUTH_DEV_LOGIN="true"

# Hosted proof of concept only: demo login protected by a shared access code (min. 12 chars).
# Seed the demo users once with SEED_DEMO_USERS=true npm run db:seed.
# DEMO_ACCESS_CODE=""
